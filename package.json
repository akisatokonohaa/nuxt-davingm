{
  "name": "create-davingm-nuxt",
  "version": "0.1.7",
  "description": "Opinionated Nuxt starter generator — scaffold project baru dalam hitungan detik",
  "bin": {
    "create-davingm-nuxt": "src/cli.js"
  },
  "files": [
    "src",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".npmignore"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "docs:dev": "vitepress dev docs --port 4000",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run test/e2e/templates.test.js"
  },
  "keywords": [
    "create",
    "nuxt",
    "nuxt3",
    "nuxt4",
    "starter",
    "boilerplate",
    "scaffold",
    "cli",
    "generator",
    "template"
  ],
  "author": {
    "name": "Davingm",
    "url": "https://davingm.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davingm/nuxt-davingm.git"
  },
  "bugs": {
    "url": "https://github.com/davingm/nuxt-davingm/issues"
  },
  "homepage": "https://nuxt.davingm.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.3",
    "vitest": "^2.1.9"
  }
}
